{
  "made_by": "sudal",
  "version": "0.1.1",
  "format_preference": {
    "operational_data": "json",
    "human_guides": "markdown",
    "reason": "JSON is preferred for task state, memory, review records, and automation. Markdown remains useful for public guides and AI-readable instructions."
  },
  "code_budget": {
    "preferred_min_lines": 200,
    "preferred_max_lines": 300,
    "hard_max_lines": 500,
    "over_preferred_action": "warn_and_consider_split",
    "over_hard_max_action": "force_task_split",
    "split_rule": "If a coding task is expected to exceed 500 lines, split it into smaller tasks before implementation."
  },
  "implementation_size_limit": {
    "unit": "changed_lines",
    "preferred": {
      "min": 200,
      "max": 300
    },
    "hard_max": 500,
    "measurement": "git diff --numstat staged + unstaged added/deleted lines",
    "if_exceeded": "TASK_SPLIT_REQUIRED"
  },
  "loop_modes": ["solo", "full"],
  "review_gate_statuses": ["PASS", "REVISION_REQUIRED"],
  "review_gate_pipeline": {
    "first": "run_tests_or_closest_verification",
    "second": "run_claude_or_external_review",
    "pass": "continue_to_next_step",
    "revision_required": "classify_findings_by_severity",
    "non_critical": "log_later_and_continue_if_safe",
    "critical": "fix_loop_then_verify_again"
  },
  "review_decisions": ["ACCEPT", "REJECT", "DEFER", "LATER"],
  "severity_levels": ["critical", "non-critical"],
  "round_policy": {
    "non_critical_after_round_1": "log_later_and_continue_if_verification_passed",
    "critical_after_round_1": "run_round_2",
    "critical_after_round_2": "ask_user_before_round_3",
    "critical_after_round_3": "rounds_4_to_5_only_with_user_direction",
    "unresolved_after_round_5": "stop_for_user_decision"
  }
}
